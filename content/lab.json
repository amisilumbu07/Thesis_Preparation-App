{
 "items": [
  {
   "id": "LAB-attention-cost",
   "cardId": "K-quadratic-cost-3",
   "title": "Attention cost when the lookback doubles",
   "setup": "Vanilla self-attention compares every position with every other. Compare a lookback of L = 96 with L = 192.",
   "checks": [
    {
     "label": "Attention pairs at L = 96",
     "expr": "Math.pow(96, 2)",
     "answer": 9216.0,
     "tol": 0.5,
     "unit": ""
    },
    {
     "label": "Attention pairs at L = 192",
     "expr": "Math.pow(192, 2)",
     "answer": 36864.0,
     "tol": 0.5,
     "unit": ""
    },
    {
     "label": "Cost factor when L doubles",
     "expr": "Math.pow(192, 2) / Math.pow(96, 2)",
     "answer": 4.0,
     "tol": 0.01,
     "unit": "x"
    }
   ]
  },
  {
   "id": "LAB-patch-96-16-8",
   "cardId": "K-patch-arith-1",
   "title": "Patches for L = 96, P = 16, S = 8",
   "setup": "N = floor((L - P) / S) + 1 with no padding. Then compare the attention matrix over N patches with the one over L points.",
   "checks": [
    {
     "label": "Number of patches N",
     "expr": "Math.floor((96 - 16) / 8) + 1",
     "answer": 11,
     "tol": 0,
     "unit": ""
    },
    {
     "label": "Attention pairs over patches (N squared)",
     "expr": "Math.pow(Math.floor((96 - 16) / 8) + 1, 2)",
     "answer": 121.0,
     "tol": 0,
     "unit": ""
    },
    {
     "label": "Shrink factor (L squared / N squared)",
     "expr": "Math.pow(96, 2) / Math.pow(Math.floor((96 - 16) / 8) + 1, 2)",
     "answer": 76.165289,
     "tol": 0.6,
     "unit": "x"
    }
   ]
  },
  {
   "id": "LAB-patch-steel",
   "cardId": "K-patch-arith-2",
   "title": "STEEL patches: P = 12, S = 6",
   "setup": "The STEEL runs used patch length 12 and stride 6 with L = 96 (author's code).",
   "checks": [
    {
     "label": "Number of patches N",
     "expr": "Math.floor((96 - 12) / 6) + 1",
     "answer": 15,
     "tol": 0,
     "unit": ""
    },
    {
     "label": "Attention pairs over patches",
     "expr": "Math.pow(Math.floor((96 - 12) / 6) + 1, 2)",
     "answer": 225.0,
     "tol": 0,
     "unit": ""
    },
    {
     "label": "Shrink factor versus L = 96",
     "expr": "Math.pow(96, 2) / Math.pow(Math.floor((96 - 12) / 6) + 1, 2)",
     "answer": 40.96,
     "tol": 0.6,
     "unit": "x"
    }
   ]
  },
  {
   "id": "LAB-patch-illustration",
